# Docker Environment Variables
# Copy this file to .env.docker and update the values

# JWT Secret for Backend Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-change-this

# Better Auth Secret for Frontend
BETTER_AUTH_SECRET=your-super-secret-better-auth-key-min-32-characters-change-this

# Database Configuration (Optional - defaults are set in docker-compose.yml)
# POSTGRES_USER=todouser
# POSTGRES_PASSWORD=todopass
# POSTGRES_DB=todoapp

# Phase 3 — Conversational AI
# OPENAI_API_KEY is required for the /chat feature to work
OPENAI_API_KEY=sk-your-openai-api-key-here
AI_MODEL=gpt-4-turbo
REDIS_URL=redis://localhost:6379
RATE_LIMIT_REQUESTS_PER_MINUTE=10
CONVERSATION_RETENTION_DAYS=30
MAX_ACTIVE_CONVERSATIONS_PER_USER=3

# ChatKit domain key (use "local-dev" for development)
NEXT_PUBLIC_CHATKIT_DOMAIN_KEY=local-dev
